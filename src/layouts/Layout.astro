---
import '../styles/global.css';
import { siteConfig, socialLinks } from '@/data/site';
import { defaultLocale, locales, localizePath, unlocalizePath, useTranslations, type Locale } from '@/i18n/utils';

interface Props {
	title: string;
	description?: string;
	/** Social-card image: an absolute path ("/og.png") or full URL. Defaults to the AIRES logo. */
	image?: string;
	/** Set for content pages so the social card and JSON-LD describe an article. */
	article?: {
		publishDate: Date;
		updatedDate?: Date;
	};
	noindex?: boolean;
}

const currentLocale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(currentLocale);
const {
	title,
	description = t('site.description'),
	image = '/aires_logo.png',
	article,
	noindex = false,
} = Astro.props;
const htmlLang = currentLocale === 'pt' ? 'pt-BR' : currentLocale;

// `Astro.site` comes from `site` in astro.config.mjs; fall back to the request
// origin so `astro dev` still produces usable absolute URLs.
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin);
const socialImage = new URL(image, origin);

// hreflang alternates for the same page in every locale.
const basePath = unlocalizePath(currentLocale, Astro.url.pathname);
const alternates = locales.map((locale) => ({
	hreflang: locale === 'pt' ? 'pt-BR' : locale,
	href: new URL(localizePath(locale, basePath), origin).href,
}));

const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Organization',
			'@id': `${origin.href}#organization`,
			name: siteConfig.name,
			alternateName: siteConfig.fullName,
			url: origin.href,
			logo: new URL('/aires_logo.png', origin).href,
			email: siteConfig.email,
			address: {
				'@type': 'PostalAddress',
				streetAddress: siteConfig.streetAddress,
				addressLocality: 'Porto Alegre',
				addressRegion: 'RS',
				addressCountry: 'BR',
			},
			sameAs: socialLinks.map((link) => link.href),
		},
		{
			'@type': 'WebSite',
			'@id': `${origin.href}#website`,
			url: origin.href,
			name: siteConfig.name,
			inLanguage: htmlLang,
			publisher: { '@id': `${origin.href}#organization` },
		},
		...(article
			? [
					{
						'@type': 'Article',
						headline: title,
						description,
						image: socialImage.href,
						datePublished: article.publishDate.toISOString(),
						dateModified: (article.updatedDate ?? article.publishDate).toISOString(),
						inLanguage: htmlLang,
						mainEntityOfPage: canonical.href,
						publisher: { '@id': `${origin.href}#organization` },
					},
				]
			: []),
	],
};
---

<html lang={htmlLang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{title}</title>
		<meta name="description" content={description} />

		<link rel="canonical" href={canonical} />
		{alternates.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
		<link rel="alternate" hreflang="x-default" href={new URL(basePath, origin).href} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content={article ? 'article' : 'website'} />
		<meta property="og:site_name" content={siteConfig.name} />
		<meta property="og:locale" content={currentLocale === 'pt' ? 'pt_BR' : 'en_US'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		{
			article && (
				<>
					<meta property="article:published_time" content={article.publishDate.toISOString()} />
					<meta
						property="article:modified_time"
						content={(article.updatedDate ?? article.publishDate).toISOString()}
					/>
				</>
			)
		}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />

		{noindex && <meta name="robots" content="noindex, follow" />}
		<meta name="generator" content={Astro.generator} />

		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

		<!-- Runs before first paint so a locale redirect never flashes the wrong language. -->
		<script is:inline define:vars={{ currentLocale, locales: [...locales], defaultLocale }}>
			const KEY = 'aires-locale-selected';
			try {
				const stored = localStorage.getItem(KEY);
				if (!stored) {
					const preferred = (navigator.language || '').toLowerCase();
					const match = locales.find((l) => preferred.startsWith(l)) || defaultLocale;
					localStorage.setItem(KEY, match);
					if (currentLocale === defaultLocale && match !== defaultLocale) {
						location.replace('/' + match + location.pathname + location.search);
					}
				} else if (stored !== currentLocale) {
					localStorage.setItem(KEY, currentLocale);
				}
			} catch {
				// localStorage unavailable (privacy mode, etc.) — skip auto-detection
			}
		</script>
	</head>
	<body class="min-h-screen antialiased">
		<slot />
	</body>
</html>
