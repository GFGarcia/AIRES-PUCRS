---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";

import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import icon from "@/assets/aires_logo_no_bg.avif";
import { siteConfig } from "@/data/site";
import { defaultLocale, useTranslations } from "@/i18n/utils";

interface Props {
	entry: CollectionEntry<"about">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, directors, membersSection } = entry.data;
const t = useTranslations(Astro.currentLocale ?? defaultLocale);
---

<Layout title={`${title} | ${siteConfig.name}`} description={description}>
	<div class='flex min-h-screen flex-col'>
		<SiteHeader />

		<main class='flex-1'>
			<article
				class='mx-auto max-w-7xl px-6 py-12 min-[420px]:px-7 sm:px-8 sm:py-16 md:px-10 md:py-20 lg:px-12 lg:py-24 xl:px-16 xl:py-28'
			>
				<h1
					class='text-center text-3xl font-bold tracking-tight text-primary sm:text-4xl md:text-5xl lg:text-6xl'
				>
					{title}
				</h1>

				<div
					class='prose prose-neutral prose-sm mt-8 max-w-none text-justify sm:prose-base sm:mt-10 md:mt-12 lg:prose-lg prose-p:text-foreground'
				>
					<Content />
				</div>

				<Image
					src={icon}
					alt=''
					role='presentation'
					width={256}
					height={256}
					class='mx-auto mt-12 w-48 sm:w-56 md:w-64'
				/>

				{
					directors && directors.length > 0 && (
						<ul class='mt-12 space-y-10 sm:mt-16'>
							{directors.map((director) => (
								<li class='flex flex-col items-center gap-5 sm:flex-row sm:items-start sm:gap-8'>
									<Image
										src={director.photo}
										alt={director.name}
										width={160}
										height={160}
										class='size-32 shrink-0 rounded-full object-cover ring-4 ring-border sm:size-36'
									/>
									<div class='text-center sm:text-left'>
										<h2 class='text-xl lg:text-2xl font-medium text-primary'>
											{director.name}
										</h2>

										<p class='text-sm text-muted-foreground'>
											{director.role && `${director.role}`}
										</p>

										<p class='mt-2 text-sm leading-relaxed text-muted-foreground sm:text-base'>
											{director.summary}
										</p>

										<div class='mt-3 w-full text-center sm:text-right'>
											<a
												href={director.lattes}
												target='_blank'
												rel='noopener noreferrer'
												class='inline-flex items-center gap-1 rounded-md border border-primary px-3 py-1.5 text-sm font-medium text-primary transition-colors hover:bg-primary hover:text-primary-foreground text-right'
											>
												{t("diretoria.lattesLink")} <span aria-hidden='true'>›</span>
											</a>
										</div>
									</div>
								</li>
							))}
						</ul>
					)
				}

				{
					membersSection && (
						<div class='mt-16 text-center sm:mt-20'>
							<h2 class='text-2xl font-semibold text-primary sm:text-3xl'>
								{membersSection.title}
							</h2>
							<p class='mx-auto mt-4 max-w-2xl text-base leading-relaxed whitespace-pre-line text-muted-foreground'>
								{membersSection.body}
							</p>
						</div>
					)
				}
			</article>
		</main>

		<SiteFooter />
	</div>
</Layout>
