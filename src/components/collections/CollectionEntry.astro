---
import { render } from "astro:content";
import type { CollectionEntry, CollectionKey } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import { OpenLetterSignupForm } from "@/components/announcements/OpenLetterSignupForm";
import { siteConfig } from "@/data/site";
import { defaultLocale, useTranslations } from "@/i18n/utils";

interface Props {
	entry: CollectionEntry<CollectionKey>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const t = useTranslations(Astro.currentLocale ?? defaultLocale);
---

<Layout
	title={`${entry.data.title} | ${siteConfig.name}`}
	description={entry.data.description}
	image={entry.data.coverImage?.src}
	article={{ publishDate: entry.data.publishDate, updatedDate: entry.data.updatedDate }}
>
	<div class="flex min-h-screen flex-col">
		<SiteHeader />

		<main class="flex-1">
			<article class="mx-auto max-w-7xl px-6 py-12 min-[420px]:px-7 sm:px-8 sm:py-16 md:px-10 md:py-20 lg:px-12 lg:py-24 xl:px-16 xl:py-28">
				<h1 class="text-3xl font-bold tracking-tight text-primary sm:text-4xl md:text-5xl lg:text-6xl">{entry.data.title}</h1>
				<p class="mt-3 text-base text-pretty text-muted-foreground sm:mt-4 sm:text-lg">{entry.data.description}</p>

				<div class="prose prose-neutral prose-sm mt-8 max-w-none sm:prose-base sm:mt-10 md:mt-12 lg:prose-lg prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-foreground prose-p:text-foreground prose-a:text-primary-strong prose-a:no-underline prose-a:transition-colors hover:prose-a:text-primary-strong/85 hover:prose-a:underline prose-strong:text-foreground prose-li:text-foreground prose-hr:border-border">
					<Content />
				</div>

				{entry.data.signupForm && (
					<OpenLetterSignupForm
						heading={t("form.signup.heading")}
						namePlaceholder={t("form.signup.namePlaceholder")}
						affiliationPlaceholder={t("form.signup.affiliationPlaceholder")}
						emailPlaceholder={t("form.signup.emailPlaceholder")}
						submitLabel={t("form.signup.submit")}
					/>
				)}
			</article>
		</main>

		<SiteFooter />
	</div>
</Layout>
