---
import { render } from "astro:content";
import type { CollectionEntry, CollectionKey } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import { siteConfig } from "@/data/site";

interface Props {
	entry: CollectionEntry<CollectionKey>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={`${entry.data.title} | ${siteConfig.name}`} description={entry.data.description}>
	<div class="flex min-h-screen flex-col">
		<SiteHeader />

		<main class="flex-1">
			<article class="mx-auto max-w-3xl px-6 py-20 sm:px-8 sm:py-28 md:px-10 lg:px-12 xl:px-16">
				<h1 class="text-4xl font-bold tracking-tight text-primary sm:text-5xl">{entry.data.title}</h1>
				<p class="mt-4 text-lg text-pretty text-muted-foreground">{entry.data.description}</p>

				<div class="prose prose-neutral mt-12 max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-headings:text-foreground prose-p:text-foreground prose-a:text-primary prose-a:no-underline prose-a:transition-colors hover:prose-a:text-primary/80 hover:prose-a:underline prose-strong:text-foreground prose-li:text-foreground prose-hr:border-border">
					<Content />
				</div>
			</article>
		</main>

		<SiteFooter />
	</div>
</Layout>
