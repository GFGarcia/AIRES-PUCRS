---
import { getCollection } from "astro:content";
import type { CollectionKey } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import { siteConfig } from "@/data/site";

interface Props {
	collection: CollectionKey;
	basePath: string;
	title: string;
	description: string;
	emptyMessage: string;
}

const { collection, basePath, title, description, emptyMessage } = Astro.props;

const entries = (await getCollection(collection, ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<Layout title={`${title} | ${siteConfig.name}`} description={description}>
	<div class="flex min-h-screen flex-col">
		<SiteHeader />

		<main class="flex-1">
			<section class="mx-auto max-w-7xl px-6 py-20 sm:px-8 sm:py-28 md:px-10 lg:px-12 xl:px-16">
				<h1 class="text-4xl font-medium tracking-tight text-primary sm:text-5xl">{title}</h1>
				<p class="mt-4 max-w-2xl text-lg text-pretty text-muted-foreground">{description}</p>

				{
					entries.length === 0 ? (
						<p class="mt-16 text-muted-foreground">{emptyMessage}</p>
					) : (
						<ul class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
							{entries.map((entry) => (
								<li>
									<a
										href={`/${basePath}/${entry.id}`}
										class="group block h-full rounded-2xl border border-border p-6 transition-colors duration-200 hover:border-primary focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50"
									>
										<h2 class="text-xl font-semibold text-foreground transition-colors group-hover:text-primary">
											{entry.data.title}
										</h2>
										<p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted-foreground">{entry.data.description}</p>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
