---
import type { CollectionKey } from "astro:content";

import Layout from "@/layouts/Layout.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import { siteConfig } from "@/data/site";
import { defaultLocale } from "@/i18n/utils";
import { getLocalizedCollection } from "@/lib/i18n-content";

interface Props {
	collection: CollectionKey;
	basePath: string;
	title: string;
	description: string;
	emptyMessage: string;
}

const { collection, basePath, title, description, emptyMessage } = Astro.props;
const currentLocale = Astro.currentLocale ?? defaultLocale;

const entries = (await getLocalizedCollection(collection, currentLocale)).sort(
	(a, b) => b.entry.data.publishDate.valueOf() - a.entry.data.publishDate.valueOf(),
);
---

<Layout title={`${title} | ${siteConfig.name}`} description={description}>
	<div class="flex min-h-screen flex-col">
		<SiteHeader />

		<main class="flex-1">
			<section class="mx-auto max-w-7xl px-6 py-12 min-[420px]:px-7 sm:px-8 sm:py-16 md:px-10 md:py-20 lg:px-12 lg:py-24 xl:px-16 xl:py-28">
				<h1 class="text-3xl font-medium tracking-tight text-primary sm:text-4xl md:text-5xl">{title}</h1>
				<p class="mt-3 max-w-2xl text-base text-pretty text-muted-foreground sm:mt-4 sm:text-lg">{description}</p>

				{
					entries.length === 0 ? (
						<p class="mt-10 text-muted-foreground sm:mt-16">{emptyMessage}</p>
					) : (
						<ul class="mt-8 grid grid-cols-1 gap-4 sm:mt-10 sm:grid-cols-2 sm:gap-6 md:mt-12 md:gap-8 lg:grid-cols-3">
							{entries.map(({ entry, slug }) => (
								<li>
									<a
										href={`/${basePath}/${slug}`}
										class="group block h-full rounded-2xl border border-border p-5 transition-colors duration-200 hover:border-primary focus-visible:border-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50 sm:p-6"
									>
										<h2 class="text-lg font-semibold text-foreground transition-colors group-hover:text-primary sm:text-xl">
											{entry.data.title}
										</h2>
										<p class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted-foreground">{entry.data.description}</p>
									</a>
								</li>
							))}
						</ul>
					)
				}
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>
