---
import { Image } from "astro:assets";

import logo from "../../assets/aires_logo_no_bg.avif";
---

<div class="relative mx-auto w-full max-w-64 sm:max-w-80 md:max-w-96 motion-safe:animate-in motion-safe:fade-in motion-safe:slide-in-from-bottom-4 motion-safe:fill-mode-both motion-safe:delay-150 motion-safe:duration-700 motion-safe:ease-out">
	<div
		aria-hidden="true"
		class="pointer-events-none absolute top-1/2 left-1/2 -z-10 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/5 blur-3xl sm:h-96 sm:w-96"
	></div>
	<Image src={logo} alt="Ilustração de uma mão humana e uma mão robótica equilibrando uma balança, simbolizando a ética na Inteligência Artificial"
		class="relative h-auto w-full" />
</div>
