---
import { Image } from 'astro:assets';

import logo from '../assets/aires_logo_no_bg.avif';
import { defaultLocale, localizePath, useTranslations } from '@/i18n/utils';

interface Props {
	class?: string;
	iconOnly?: boolean;
}

const { class: className, iconOnly = false } = Astro.props;
const currentLocale = Astro.currentLocale ?? defaultLocale;
const t = useTranslations(currentLocale);
---

<a
	href={localizePath(currentLocale, '/')}
	class:list={["flex items-center gap-2 sm:gap-3 shrink-0 transition-opacity duration-200 hover:opacity-80", className]}
	aria-label={t('logo.homeAriaLabel')}
>
	<Image
		src={logo}
		alt="AIRES PUCRS logo"
		width={48}
		height={48}
		densities={[1, 2]}
		loading="eager"
		fetchpriority="high"
		class="size-10 sm:size-12 shrink-0 object-contain"
	/>
	{
		!iconOnly && (
			<span class="text-lg font-medium tracking-tight text-foreground ">
				AI Robotics Ethics Society<sup class="text-[0.6em] font-normal">®</sup>
			</span>
		)
	}
</a>
