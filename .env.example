# Web3Forms access keys (https://web3forms.com) — one per form, each created
# separately in the Web3Forms dashboard so submissions stay organized and can
# be routed to different inboxes. These are meant to be public: Vite exposes
# any PUBLIC_* var to client code, which is how Web3Forms expects to be used.

# src/components/announcements/OpenLetterSignupForm.tsx
PUBLIC_WEB3FORMS_OPEN_LETTER_SIGN_UP_KEY=

# src/components/contact/ContactForm.tsx
PUBLIC_WEB3FORMS_CONTACT_KEY=
